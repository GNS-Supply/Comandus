rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function ehMaster() { return logado() && exists(/databases/$(database)/documents/master/$(request.auth.uid)); }
    function equipe(l) { return logado() && exists(/databases/$(database)/documents/tenants/$(l)/equipe/$(request.auth.uid)); }
    function perfil(l) { return get(/databases/$(database)/documents/tenants/$(l)/equipe/$(request.auth.uid)).data.perfil; }
    function gerente(l) { return ehMaster() || (equipe(l) && perfil(l) == 'admin'); }
    function operacao(l) { return gerente(l) || (equipe(l) && perfil(l) in ['balcao', 'cozinha']); }

    // Crie manualmente no Console: master/{uid do Master} (documento vazio)
    match /master/{uid} { allow read: if logado() && request.auth.uid == uid; }

    match /tenants/{l} {
      allow read: if true;
      allow write: if ehMaster();

      match /cardapio/{id} { allow read: if true; allow write: if gerente(l); }

      match /mesas/{id} {
        allow read: if logado();
        allow create, delete: if gerente(l);
        // cliente (anônimo) só altera status e chamado
        allow update: if operacao(l) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chamado']);
      }
      match /comandas/{id} {
        allow read: if logado();
        allow create: if logado() && request.resource.data.status == 'aberta';
        allow update: if operacao(l) || (resource.data.status == 'aberta' && request.resource.data.status == 'aberta');
        allow delete: if gerente(l);
      }
      match /promocoes/{id} { allow read: if true; allow write: if gerente(l); }
      match /avaliacoes/{id} { allow create: if logado(); allow read: if gerente(l); }
      match /config/{id} { allow read: if true; allow write: if gerente(l); }
      match /clientes/{id} { allow read, write: if operacao(l); }
      match /reservas/{id} { allow read, write: if operacao(l); }
      // Cadastro livre: qualquer pessoa cria o PRÓPRIO acesso, sempre como 'cliente'.
      // Só a Loja (admin) ou o Master criam outros acessos e mudam perfis, nunca para 'master'.
      // O Master não tem documento aqui (fica em /master), por isso é invisível para a equipe.
      match /equipe/{uid} {
        allow read: if logado() && (request.auth.uid == uid || gerente(l));
        allow create: if logado() && request.auth.uid == uid && request.resource.data.perfil == 'cliente';
        allow create, update: if gerente(l) && request.resource.data.perfil in ['admin', 'balcao', 'cozinha', 'cliente'];
        allow delete: if gerente(l);
      }
    }
  }
}
